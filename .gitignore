# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
.env
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

./tests
/local.database.sqlite
/.angular/
/apps/app/public/assets/locales/.cache/
/libs/app/generated/src/core/

# Database backups
/backups/*.sql
/backups/*.sql.gz
!/backups/.gitkeep

# Setup wizard run reports (generated by @app-galaxy/setup-api)
/setup/reports/

# Playwright reusable auth session (apps/app-e2e). STORAGE_STATE is a
# workspace-relative path, so running the suite from apps/app-e2e itself
# writes it to the doubled path instead — ignore that copy too.
/apps/app-e2e/.auth/
/apps/app-e2e/apps/

.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
/playwright-report/
/test-output/

.angular

# Generated API client (npm run ng-swagger)
/libs/app/generated/src/core/

# Transmart translation cache
/apps/app/public/assets/locales/.cache/
