APP_NAME="slim"
APP_ENV_LOCAL=1
APP_ENV=development
APP_SECRET='SLIM&1234'
API_AUTH_TEMPLATE_USE_EMAIL_TABLE='true'

# Demo user (seeded in non-production by apps/api/src/mocks)
APP_DEFAULT_USER='slim@demo.ch'
APP_DEFAULT_PASSWORD='1234'
# Demo dataset (apps/api/src/mocks/tenant/tenant.mock.json): written on every
# non-production start and rolled to the current year. DEMO_SEED=0 leaves the
# tenant alone; DEMO_RESEED=1 empties and rewrites it on the next start.
DEMO_SEED=1
DEMO_RESEED=0

# API
API_ACCESS_CONTROL_ORIGIN="*"
API_SWAGGER_ENABLED=1
# Development: always return sensitive fields (names, e-mail, phone) unmasked.
# Leave unset in production — there the «Sensible Daten»-Rolle + X-Sensitive-Data header decide.
API_AUTH_BYPASS_SENSITIVE_DATA=1
# Regenerate libs/app/generated (@ui-slim/apiClient) on API start (non-production). 0 = off
API_SWAGGER_GENERATE_CLIENT=1
API_PORT=3333
API_LOGGING=0
API_TRUST_PROXY=1
API_ALLOW_TENANT_APP_CONFIG_BY_DOMAIN_NAME='true'

# Rate limiting (auth + public prefixes, requests per minute per IP)
API_RATE_LIMIT_AUTH=20
API_RATE_LIMIT_PUBLIC=60

# Put the app's roleKey in the session's role claim instead of the numeric appId.
API_SESSION_APP_ROLE_NAME=1
APP_AUTH_ADMIN_USER_GUARD_ROLES_TENANT_GUARD=1
APP_AUTH_ADMIN_ROLE_GUARD_ROLES_TENANT_GUARD=2

# Password policy (@app-galaxy/auth-api). Production: >= 10, elevated roles 18.
API_AUTH_PASSWORD_MIN_LENGTH=4
API_AUTH_PASSWORD_HISTORY_ENABLED=0
API_AUTH_LOGIN_LOCKOUT_ENABLED=0

# Database (dev)
DB_LOG=0
DB_SYNC=1
DB_TYPE='sqlite'
DB_DATABASE='local.database.sqlite'

# Database (production target: PostgreSQL 17 + PostGIS, docker compose up app-postgis)
#DB_TYPE='postgres'
#DB_HOST='127.0.0.1'
#DB_PORT=5432
#DB_DATABASE='app-slim'
#DB_USERNAME='slim'
#DB_PASSWORD='slim'

# Database (MariaDB alternative)
#DB_TYPE='mariadb'
#DB_HOST='127.0.0.1'
#DB_PORT=3306
#DB_DATABASE='app-slim'
#DB_USERNAME='root'
#DB_PASSWORD='root'

# Mail (password reset, e-mail verification, 2FA codes)
MAIL_HOST=''
MAIL_PORT=''
MAIL_SECURE=''
MAIL_USER=''
MAIL_PASS=''
#MAIL_SENDER=''
#MAIL_FROM_NAME='SLIM'

# Redis (production cluster only)
REDIS_URL=redis://localhost:6379

# pm2 (ecosystem.config.js)
API_CLUSTER_INSTANCES=1
API_CLUSTER_EXEC_MODE=fork

TZ=UTC
SYSTEM_TENANT_ID=system

# Machine translation of the locale files (npm run translate)
OPEN_API_KEY=''
NPM_TOKEN=''
