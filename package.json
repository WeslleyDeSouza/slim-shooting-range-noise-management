  "license": "MIT",
  "private": true,
  "scripts": {
    "ng-swagger": "node tools/swagger.generator.js",
    "graph:build": "nx graph --groupByFolder --file=graph.json",
    "all": "concurrently \"npx nx serve api\" \"npx nx serve app\"",
    "start": "npm run all",
    "setup": "npx @app-galaxy/setup-api --parallel",
    "setup:debug": "npx @app-galaxy/setup-api --parallel --sidebar=true --report=true",
    "build": "npx nx run-many -t build --projects=api,app",
    "test": "npx nx run-many -t test",
    "test:api": "npx nx test api",
    "test:app": "npx nx test app",
    "e2e": "npx nx e2e app-e2e",
    "lint": "npx nx run-many -t lint",
    "start:pm2": "pm2 start ecosystem.config.js",
    "ngsw": "node_modules/.bin/ngsw-config dist/apps/app/browser ./apps/app/ngsw-config.json && cp node_modules/@angular/service-worker/ngsw-worker.js dist/apps/app/browser/ngsw-worker.js",
    "stats:app": "npx webpack-bundle-analyzer dist/apps/app/stats.json",
    "translate": "npx transmart",
    "translate:tool": "node tools/transmart.js",
    "docs:docx": "node tools/docx.build.js"
  },
