APP_NAME="slim"
APP_ENV_LOCAL=1
APP_ENV=development
APP_SECRET='SLIM&1234'

#Demo User
APP_DEFAULT_USER='slim@demo.ch'
APP_DEFAULT_PASSWORD='1234'

# API
API_ACCESS_CONTROL_ORIGIN="*"
API_SWAGGER_ENABLED=1
API_PORT=3333
API_LOGGING=0

# Rate limiting (requests per minute per IP)
API_TRUST_PROXY=1
API_RATE_LIMIT_AUTH=20
API_RATE_LIMIT_PUBLIC=60

#Database
DB_LOG=0
DB_SYNC=1
DB_TYPE='sqlite'
DB_DATABASE='local.database.sqlite'

#Database Alternative
#DB_PORT=3306
#DB_TYPE='mariadb'
#DB_HOST='localhost'
#DB_DATABASE='app-slim'
#DB_PASSWORD='root'
#DB_USERNAME='root'

#Mail
MAIL_HOST=''
MAIL_PORT=''
MAIL_SECURE=''
MAIL_USER=''
MAIL_PASS=''
#MAIL_SENDER=''
#MAIL_FROM_NAME='SLIM'

#Redis (production only)
REDIS_URL=redis://localhost:6379

TZ=UTC
SYSTEM_TENANT_ID=system

NPM_TOKEN=''

# Machine translation of the locale files (npm run translate)
OPEN_API_KEY=''
